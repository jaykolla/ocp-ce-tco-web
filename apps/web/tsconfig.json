{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ocp-tco/model-schema": ["../../packages/model-schema/src/index.ts"],
      "@ocp-tco/model-engine": ["../../packages/model-engine/src/index.ts"],
      "@ocp-tco/seed-data": ["../../packages/seed-data/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/model-schema/src",
    "../../packages/model-engine/src",
    "../../packages/seed-data/src"
  ],
  "exclude": ["node_modules"]
}
